{
  "name": "winget-gui",
  "version": "1.0.0",
  "private": true,
  "description": "Tauri GUI for selecting and running winget package upgrades.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "tauri dev",
    "dev:app": "tauri dev",
    "tauri": "tauri",
    "portable": "tauri build --no-bundle && node scripts/collect-release.cjs --portable-only",
    "release:win": "tauri build && node scripts/collect-release.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.5.0",
    "lucide-react": "^0.468.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.3.0"
  }
}
