{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winget GUI",
  "version": "../package.json",
  "identifier": "com.est.winget-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5317",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Winget GUI",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#1e1f22",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico"
      }
    }
  }
}
